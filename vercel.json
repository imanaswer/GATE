{
  "functions": {
    "api/index.py": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/expire-attempts",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/v1/cron/scan-integrity",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v1/cron/refresh-overview",
      "schedule": "0 4 * * *"
    }
  ]
}
