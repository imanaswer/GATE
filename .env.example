# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable/anon key>
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase → Connect → Transaction pooler (port 6543). NOT the direct 5432 URL:
# serverless instances against a direct port will exhaust Postgres connections.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Only for legacy projects that still sign JWTs with a shared HS256 secret.
# Newer projects use asymmetric keys and this can stay empty.
SUPABASE_JWT_SECRET=

EVENT_SLUG=tech-arena-2026
NEXT_PUBLIC_SITE_URL=http://localhost:3000
