# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable/anon key>
SUPABASE_URL=https://<project-ref>.supabase.co

# Runtime: Supabase → Connect → TRANSACTION pooler (port 6543). NOT the direct
# 5432 URL — serverless instances against a direct port exhaust Postgres
# connections, which is the classic way this architecture falls over.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Migrations only: the DIRECT connection (port 5432) or the session pooler.
# Transaction-mode pooling does not reliably support DDL or session-level
# statements, so `pnpm db:push` must not go through the 6543 URL above.
MIGRATION_DATABASE_URL=postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres

# Only for legacy projects that still sign JWTs with a shared HS256 secret.
# Newer projects use asymmetric keys and this can stay empty.
SUPABASE_JWT_SECRET=

EVENT_SLUG=tech-arena-2026
# Origin printed into every certificate QR code. Backend-only, so no
# NEXT_PUBLIC_ prefix: it must not be inlined into the client bundle.
SITE_URL=http://localhost:3000

# Shared secret for the scheduled attempt-expiry sweep.
CRON_SECRET=

# Signs admin session cookies. Unset means the admin panel refuses to issue a
# session at all, which is deliberate — never a forgeable default.
ADMIN_SECRET=

# Opt-in for legacy symmetric (HS256) Supabase JWTs. Leave unset: newer
# projects use asymmetric JWKS keys, and a leaked shared secret lets anyone
# mint a token for any user. Refused outright when VERCEL_ENV=production.
ALLOW_HS256_JWT=

# Optional. Unset means errors still reach the platform log; Sentry adds
# grouping and alerting, not the record itself.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
